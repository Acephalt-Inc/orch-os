{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orch-os.example/schemas/cap-envelope-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["value", "unit", "method", "citations", "citations_truncated", "confidence", "conflicts", "conflicts_truncated", "usage"],
  "properties": {
    "value": {},
    "unit": { "type": "string", "minLength": 1, "maxLength": 100 },
    "method": { "enum": ["extracted", "computed", "adjudicated"] },
    "citations": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["doc_id", "page", "quote"],
        "properties": {
          "doc_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "page": { "type": "integer", "minimum": 1 },
          "quote": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "citations_truncated": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "conflicts": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "sources", "verdict", "why"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "sources": { "type": "array", "maxItems": 100, "items": {} },
          "verdict": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "why": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "conflicts_truncated": { "type": "boolean" },
    "usage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "credits": { "type": "number", "minimum": 0 },
        "pages": { "type": "number", "minimum": 0 },
        "model_tokens": { "type": "number", "minimum": 0 }
      }
    }
  }
}
