{
  "name": "orch-os",
  "version": "2.0.1",
  "description": "Run several CLI coding agents as one team: role lease, mailbox, addressed messages, task claims, review-based merge gate, detached workers with git worktrees, load governor, long-lived notes.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Winnicent Zuo, Acephalt Inc. <winnicent.zuo@acephalt.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Acephalt-Inc/orch-os.git"
  },
  "homepage": "https://github.com/Acephalt-Inc/orch-os#readme",
  "bugs": {
    "url": "https://github.com/Acephalt-Inc/orch-os/issues"
  },
  "type": "module",
  "bin": {
    "orch": "dist/cli.js"
  },
  "files": [
    "dist/",
    "fixtures/",
    "schemas/",
    "templates/",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "LICENSE-INTERNAL-USE",
    "LICENSE-NONCOMMERCIAL",
    "THIRD_PARTY_NOTICES.md",
    "NOTICE",
    "AUTHORS"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/cap.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cap.js",
    "test": "npm run build && vitest run",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "agents",
    "orchestration",
    "multi-agent",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^20.19.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
